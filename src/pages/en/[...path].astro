---
/**
 * Anglické obsahové stránky. Cesta souboru v `src/content/page/en/` je zároveň
 * URL pod `/en/`, stejně jako u české verze na kořeni.
 */
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../../components/islands/PageBody.astro';
import { getPage, listPages } from '../../lib/data';
import { islands } from '../../lib/islands';

// Jazyk se uvnitř `getStaticPaths` musí psát literálem — Astro tu funkci
// vytrhne do vlastního modulu, kde proměnné z frontmatteru neexistují.
const lang = 'en' as const;

export async function getStaticPaths() {
	const [pages, translated] = await Promise.all([listPages('en'), listPages('cs')]);
	const czech = new Set(translated.map((page) => page.path));

	return pages
		.filter((page) => page.path !== 'home')
		.map((page) => ({
			params: { path: page.path },
			props: { translatedPath: czech.has(page.path) ? `/${page.path}/` : null },
		}));
}

const { translatedPath } = Astro.props;
const path = (Astro.params.path ?? '').toString();
const page = await getPage(path, lang);
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });
---
<Base
	lang={lang}
	title={data.seo?.title || data.title}
	description={data.seo?.description}
	image={data.seo?.image}
	noindex={data.seo?.noindex}
	translatedPath={translatedPath}
>
	<TinaIsland name="page" wrapper={islands.page.wrapper} params={{ path, lang }} primary>
		<PageBody data={data} />
	</TinaIsland>
</Base>
