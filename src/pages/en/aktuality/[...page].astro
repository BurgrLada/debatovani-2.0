---
/**
 * Anglický výpis aktualit, `/en/aktuality/`. Cesta v URL zůstává česká, aby
 * odpovídala rozvržení obsahu (`src/content/article/<jazyk>/`) a nevznikla
 * druhá sada přesměrování — anglických článků je devět a všechny měly na
 * starém webu adresu pod `/aktuality/`.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import NewsList from '../../../components/layout/NewsList.astro';
import { listArticles } from '../../../lib/data';
import { t } from '../../../lib/i18n';

// Jazyk se uvnitř `getStaticPaths` musí psát literálem — Astro tu funkci
// vytrhne do vlastního modulu, kde proměnné z frontmatteru neexistují.
const lang = 'en' as const;
const strings = t(lang);

export const getStaticPaths = (async ({ paginate }) => {
	const articles = await listArticles('en');
	return paginate(articles, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
// Stránkování se mezi jazyky nekryje (356 vs. 9 článků), takže protějšek
// hlásíme jen u první strany.
const translatedPath = page.currentPage === 1 ? '/aktuality/' : null;
---
<Base
	title={strings.news}
	description={strings.newsFeedDescription}
	lang={lang}
	translatedPath={translatedPath}
>
	<NewsList page={page} lang={lang} />
</Base>
