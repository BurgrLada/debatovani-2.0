---
/**
 * Portál debatování — přenesený 1:1 ze starého webu.
 *
 * Tahle stránka záměrně stojí mimo zbytek webu: má vlastní `<head>`, vlastní
 * Tailwind (play CDN, jako dnes), Font Awesome a vlastní JS. Na WordPressu
 * běžela jako `cleanpage` bez hlavičky a patičky a subdoména
 * `portal.debatovani.cz` ji zobrazovala ve fullscreen iframu.
 *
 * Proto se **nepřevádí na bloky** a nepoužívá layout `Base` — zásah do
 * rozvržení nebo tříd by ji rozbil. Změny sem patří jen tehdy, když se mění
 * samotný portál.
 *
 * Odchylky od originálu, všechny nutné:
 *  - obrázky a PDF ukazují na lokální kopie v `/media/portal/`
 *  - odkazy na vlastní web jsou relativní
 *  - z odkazů zmizely `_gl` parametry Google Analytics (zbytky cizí relace)
 *  - seznam aktualit se načítá z `/portal/news.json` místo `wp-json`,
 *    aby portál přežil vypnutí WordPressu (tvar dat zůstal stejný)
 *
 * TODO: play CDN Tailwindu není určené pro produkci. Až se portál bude
 * upravovat, převést jeho třídy na projektový Tailwind (pozor na rozdíly
 * v3 → v4, hlavně `rounded` a `shadow`).
 */

// Stránka nepoužívá `global.css`, takže si písmo musí natáhnout sama.
// Bez podmnožiny `latin` by Poppins pokryl jen znaky s diakritikou.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
---
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Portál debatování – Asociace debatních klubů z.s.</title>
		<meta
			name="description"
			content="Rozcestník pro aktivní debatérky, debatéry a kouče — přihlášky na turnaje, nástroje, metodika a výsledky."
		/>
		<link rel="canonical" href="https://debatovani.cz/portal/" />
		<link rel="icon" href="/media/brand/favicon-32.png" sizes="32x32" />
		<link rel="icon" href="/media/brand/favicon-192.png" sizes="192x192" />
		<script is:inline src="https://cdn.tailwindcss.com"></script>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
			integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<style is:global>
			:root {
				--orange: #f3dac1;
				--green: #f1f3be;
				--blue: #bde3f5;
			}
			html {
				scroll-behavior: smooth;
			}
			/*
			 * Základní barvy a prokládání přebírá portál na produkci ze
			 * šablony `alone`, kterou tady nemáme. Bez nich text vychází
			 * čistě černý, a proto působí tučněji než na produkci.
			 */
			body {
				font-family: 'Poppins', system-ui, sans-serif;
				font-weight: 400;
				font-size: 16px;
				line-height: 1.5;
				color: #333;
			}
			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				color: #111;
				line-height: 1.25;
			}
			a {
				color: inherit;
			}
		</style>
	</head>
	<body class="cleanpage">



    <button id="scrollTop" title="Zpět nahoru"
        class="fixed hidden lg:!hidden bottom-6 right-8 bg-[var(--orange)] py-2 px-3 rounded shadow-lg transition-transform hover:-translate-y-1">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <div class="my-10 mx-2 lg:m-10">

        <div class="text-center lg:hidden mb-8">
            <a href="/" title="Debatování.cz" class="inline-block">
                <img decoding="async" src="/media/portal/logo.png" width="120px"
                    class="mx-auto mb-4 transition-all duration-500 hover:rotate-[720deg]">
            </a>
            <h1 class="text-3xl">Portál debatování</h1>
        </div>

        <div class="grid lg:grid-cols-3 gap-4">

