                <div class="grid grid-cols-2 gap-3 max-w-[400px] mx-auto auto-rows-[1fr]">

                    <a href="/"
                        class="col-span-2 bg-[var(--orange)] shadow-md hover:shadow-lg rounded-xl p-2 flex flex-col justify-center border border-transparent text-black hover:text-black hover:border-black focus:text-black text-center items-center transition-all duration-300 hover:-translate-y-1 min-h-28">
                        <div class="m-2 mb-3">
                            <img decoding="async"
                                src="/media/portal/loga_ADK_blk.svg" width="30px"
                                alt="ADK">
                        </div>
                        <div class="font-medium">Web ADK</div>
