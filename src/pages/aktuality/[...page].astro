---
/**
 * Výpis aktualit se stránkováním. `/aktuality/`, `/aktuality/2/`, …
 * Články samotné jsou na `/aktuality/<slug>/` — jejich routa je specifičtější,
 * takže má přednost.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import NewsList from '../../components/layout/NewsList.astro';
import { listArticles } from '../../lib/data';
import { t } from '../../lib/i18n';

const lang = 'cs' as const;
const strings = t(lang);

export const getStaticPaths = (async ({ paginate }) => {
	const articles = await listArticles();
	return paginate(articles, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
// Stránkování se mezi jazyky nekryje (356 vs. 9 článků), takže protějšek
// hlásíme jen u první strany.
const translatedPath = page.currentPage === 1 ? '/aktuality/' : null;
---
<Base
	title={strings.news}
	description={strings.newsFeedDescription}
	lang={lang}
	translatedPath={translatedPath}
>
	<NewsList page={page} lang={lang} />
</Base>
