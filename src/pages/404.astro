---
import Base from '../layouts/Base.astro';
import Container from '../components/ui/Container.astro';
import Heading from '../components/ui/Heading.astro';
import Button from '../components/ui/Button.astro';
---
<Base title="Stránka nenalezena" noindex>
	<Container class="py-24 text-center">
		<Heading level={1} size="section" align="center">Tuhle stránku jsme nenašli</Heading>
		<p class="mx-auto mt-4 max-w-xl">
			Odkaz je nejspíš starý nebo obsahuje překlep. Zkuste hlavní rozcestník nebo aktuality.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<Button href="/" variant="lime" size="sm">Na úvodní stránku</Button>
			<Button href="/aktuality/" variant="sky" size="sm">Aktuality</Button>
		</div>
	</Container>
</Base>
