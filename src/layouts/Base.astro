---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { getGlobal } from '../lib/data';
import { islands } from '../lib/islands';
import { t, type Lang } from '../lib/i18n';

interface Props {
	title?: string | null;
	description?: string | null;
	image?: string | null;
	noindex?: boolean | null;
	type?: 'website' | 'article';
	lang?: Lang;
	/** Cesta bez jazykového prefixu, pokud stránka existuje i v druhém jazyce. */
	translatedPath?: string | null;
}

const { title, description, image, noindex, type, lang = 'cs', translatedPath } = Astro.props;
const global = (await getGlobal(lang)).data?.global ?? null;
const strings = t(lang);

const pageTitle = title
	? `${title} – ${global?.siteName ?? 'Asociace debatních klubů'}`
	: (global?.seo?.title ?? global?.siteName ?? 'Asociace debatních klubů');
---
<html lang={lang}>
	<head>
		<BaseHead
			title={pageTitle}
			description={description ?? global?.seo?.description}
			image={image ?? global?.seo?.image}
			noindex={noindex}
			type={type}
			lang={lang}
			translatedPath={translatedPath}
		/>
	</head>
	<body class="flex min-h-screen flex-col">
		<a
			href="#obsah"
			class="sr-only rounded-button bg-action px-4 py-2 focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[60]"
		>
			{strings.skipToContent}
		</a>
		{/*
		  Hlavička a patička jsou samostatné editovatelné oblasti — bez obalu
		  `TinaIsland` by na ně editor neuměl navázat formulář a klik na položku
		  menu nebo na patičku by nic neudělal.
		*/}
		<TinaIsland
			name="header"
			wrapper={islands.header.wrapper}
			params={{ lang, path: Astro.url.pathname, translated: translatedPath ?? '' }}
		>
			<Header
				global={global}
				currentPath={Astro.url.pathname}
				lang={lang}
				translatedPath={translatedPath}
			/>
		</TinaIsland>
		<main id="obsah" class="flex-1">
			<slot />
		</main>
		<TinaIsland name="footer" wrapper={islands.footer.wrapper} params={{ lang }}>
			<Footer global={global} />
		</TinaIsland>
		<script src="../scripts/reveal.ts"></script>
	</body>
</html>
