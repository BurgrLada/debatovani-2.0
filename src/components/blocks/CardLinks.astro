---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { langFromPath, t } from '../../lib/i18n';
import type { CardLinksBlock } from '../../lib/data';

interface Props { data: CardLinksBlock }

const { data } = Astro.props;
const strings = t(langFromPath(Astro.url.pathname));
const items = (data.items ?? []).filter((i) => i !== null);
const columns: Record<string, string> = {
	'2': 'sm:grid-cols-2',
	'3': 'sm:grid-cols-2 lg:grid-cols-3',
	'4': 'sm:grid-cols-2 lg:grid-cols-4',
};
---
<Section
	background={data.background as never}
	backgroundImage={data.backgroundImage}
	overlay={data.overlay}
	overlayTone={data.overlayTone as never}
	parallax={data.parallax}
	textTone={data.textTone as never}
	panel={data.panel}
	overlap={data.overlap}
	padding={data.padding as never}
	paddingTop={data.paddingTop as never}
	paddingBottom={data.paddingBottom as never}
	id={data.anchor}
>
	{data.title && (
		<div data-tina-field={tinaField(data, 'title')}>
			<Heading
				level={2}
				size={(data.titleSize as never) ?? 'section'}
				tone={(data.titleTone as never) ?? 'heading'}
				align={(data.titleAlign as never) ?? 'center'} class="mb-10"
			>{data.title}</Heading>
		</div>
	)}
	<ul class={`grid grid-cols-1 gap-8 ${columns[data.columns ?? '3'] ?? columns['3']}`}>
		{items.map((item) => (
			<li data-tina-field={tinaField(item)} class="flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface">
				{item.image && (
					<Image src={item.image} alt="" width={600} height={400} format="webp" class="aspect-[3/2] w-full object-cover" />
				)}
				<div class="flex flex-1 flex-col p-6">
					<h3 class="font-display text-xl font-bold text-heading">
						{item.href ? <a href={item.href}>{item.title}</a> : item.title}
					</h3>
					{item.description && <p class="mt-3 text-copy">{item.description}</p>}
					{item.href && (
						<a href={item.href} class="mt-auto pt-5 font-semibold underline underline-offset-2">
							{item.linkLabel || strings.show}
						</a>
					)}
				</div>
			</li>
		))}
	</ul>
</Section>
