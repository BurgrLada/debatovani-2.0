---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import { mdxComponents } from '../mdx/components';
import type { AccordionBlock } from '../../lib/data';

interface Props { data: AccordionBlock }

const { data } = Astro.props;
const items = (data.items ?? []).filter((i) => i !== null);
---
<Section
	background={data.background as never}
	backgroundImage={data.backgroundImage}
	overlay={data.overlay}
	overlayTone={data.overlayTone as never}
	parallax={data.parallax}
	textTone={data.textTone as never}
	panel={data.panel}
	overlap={data.overlap}
	padding={data.padding as never}
	paddingTop={data.paddingTop as never}
	paddingBottom={data.paddingBottom as never}
	id={data.anchor}
>
	{data.title && (
		<div data-tina-field={tinaField(data, 'title')}>
			<Heading
				level={2}
				size={(data.titleSize as never) ?? 'section'}
				tone={(data.titleTone as never) ?? 'heading'}
				align={(data.titleAlign as never) ?? 'center'} class="mb-8"
			>{data.title}</Heading>
		</div>
	)}
	{/* <details> místo JS akordeonu — funguje bez skriptu a je přístupné z klávesnice */}
	<div class="mx-auto max-w-3xl divide-y divide-line border-y border-line">
		{items.map((item) => (
			<details data-tina-field={tinaField(item)} class="group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-display text-lg font-semibold text-subheading">
					{item.question}
					<span aria-hidden="true" class="shrink-0 text-2xl leading-none transition-transform group-open:rotate-45">+</span>
				</summary>
				<div class="prose-adk pb-5">
					<TinaMarkdown content={item.answer} components={mdxComponents} />
				</div>
			</details>
		))}
	</div>
</Section>
