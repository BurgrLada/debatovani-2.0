---
import { Image } from 'astro:assets';
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { mdxComponents } from '../mdx/components';
import { cn } from '../../lib/cn';
import type { TextWithImageBlock } from '../../lib/data';

interface Props { data: TextWithImageBlock }

const { data } = Astro.props;
const buttons = (data.buttons ?? []).filter((b) => b !== null);
const imageFirst = data.imagePosition === 'left';

// Poměr sloupců odpovídá mřížce Elementoru (50/50, 33/67, 67/33).
const ratios: Record<string, [string, string]> = {
	half: ['md:w-1/2', 'md:w-1/2'],
	third: ['md:w-2/3', 'md:w-1/3'],
	'two-thirds': ['md:w-1/3', 'md:w-2/3'],
};
const [textWidth, imageWidth] = ratios[data.imageWidth ?? 'half'] ?? ratios.half;
---
<Section
	background={data.background as never}
	backgroundImage={data.backgroundImage}
	overlay={data.overlay}
	overlayTone={data.overlayTone as never}
	parallax={data.parallax}
	textTone={data.textTone as never}
	panel={data.panel}
	overlap={data.overlap}
	padding={data.padding as never}
	paddingTop={data.paddingTop as never}
	paddingBottom={data.paddingBottom as never}
	id={data.anchor}
>
	<div class={cn('flex flex-col gap-8 md:flex-row md:items-center', imageFirst && 'md:flex-row-reverse')}>
		<div class={cn('w-full', textWidth)}>
			{data.title && (
				<div data-tina-field={tinaField(data, 'title')}>
					<Heading
				level={2}
				size={(data.titleSize as never) ?? 'section'}
				tone={(data.titleTone as never) ?? 'heading'}
				align={(data.titleAlign as never) ?? 'center'} class="mb-6"
			>{data.title}</Heading>
				</div>
			)}
			<div data-tina-field={tinaField(data, 'body')} class="prose-adk">
				<TinaMarkdown content={data.body} components={mdxComponents} />
			</div>
			{buttons.length > 0 && (
				<div class="mt-8 flex flex-wrap justify-center gap-4">
					{buttons.map((button) => (
						<div data-tina-field={tinaField(button)}>
							<Button href={button.href} variant={button.variant as never}>{button.label}</Button>
						</div>
					))}
				</div>
			)}
		</div>
		{data.image && (
			<div class={cn('w-full', imageWidth)} data-tina-field={tinaField(data, 'image')}>
				<Image
					src={data.image}
					alt={data.alt ?? ''}
					width={800}
					height={600}
					format="webp"
					quality={80}
					class="h-auto w-full rounded-card object-cover"
				/>
			</div>
		)}
	</div>
</Section>
