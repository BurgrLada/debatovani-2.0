---
/** Obsahová šířka webu — 1200 px, změřeno z Elementor kitu. */
import { cn } from '../../lib/cn';

interface Props {
	class?: string;
	wide?: boolean;
}

const { class: className, wide = false } = Astro.props;
---
<div class={cn('mx-auto w-full px-5 sm:px-8', wide ? 'max-w-none' : 'max-w-[var(--container-max)]', className)}>
	<slot />
</div>
