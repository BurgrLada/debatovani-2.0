---
/**
 * Obal sekce stránky. Sjednocuje to, co Elementor řešil na každé sekci zvlášť:
 * pozadí, šířku, svislé odsazení a pohyb pozadí při scrollování.
 *
 * `panel` kreslí pozadí do rámečku uvnitř obsahové šířky místo přes celou
 * obrazovku, `overlap` sekci zasadí do sousedních bloků — přesně tak je na
 * dnešním webu vsazená sekce s mapou klubů mezi formulář a nabídku kurzů.
 *
 * Zanoření je změřené na produkci (`.elementor-element-bddcbb7`): sekce má
 * `margin: -100px 0` a **žádné vlastní pozadí**, takže v překryvu prosvítá
 * fotka nad ní a limetkový pás pod ní; barvu nese až karta uvnitř. Karta sedí
 * 15 px pod horní a nad dolní hranou sekce (na produkci to dělá odsazení
 * Elementor sloupce), takže do souseda ukousne 85 px a obsahu souseda zbyde
 * 15 px vzduchu. Sousedé si těch 100 px kompenzují odsazením `xl`.
 */
import Container from './Container.astro';
import { cn } from '../../lib/cn';

export type SectionBackground = 'none' | 'alt' | 'lime' | 'dark' | 'image';

interface Props {
	background?: SectionBackground | null;
	backgroundImage?: string | null;
	overlay?: boolean | null;
	overlayTone?: 'dim' | 'navy' | null;
	textTone?: 'default' | 'black' | 'inverse' | null;
	parallax?: boolean | null;
	panel?: boolean | null;
	overlap?: boolean | null;
	width?: 'boxed' | 'full' | null;
	padding?: 'none' | 'normal' | 'large' | 'xl' | null;
	paddingTop?: 'none' | 'normal' | 'large' | 'xl' | null;
	paddingBottom?: 'none' | 'normal' | 'large' | 'xl' | null;
	id?: string | null;
	class?: string;
}

const {
	background = 'none',
	backgroundImage,
	overlay = false,
	overlayTone = 'dim',
	textTone = 'default',
	parallax = false,
	panel = false,
	overlap = false,
	width = 'boxed',
	padding = 'normal',
	paddingTop,
	paddingBottom,
	id,
	class: className,
} = Astro.props;

/*
 * Barva textu se odvozuje od pozadí, ale musí jít přebít: sekce s čísly má
 * na dnešním webu fotku a přesto černý text, protože je ta fotka světlá.
 */
const backgrounds: Record<string, string> = {
	none: 'bg-surface',
	alt: 'bg-surface-alt',
	lime: 'bg-surface-lime',
	dark: 'bg-surface-dark',
	image: 'bg-cover bg-center',
};

const defaultTextTone: Record<string, string> = {
	none: '',
	alt: '',
	lime: '',
	dark: 'text-inverse',
	image: 'text-inverse',
};

const textTones: Record<string, string> = {
	default: defaultTextTone[background ?? 'none'] ?? '',
	black: 'text-copy',
	inverse: 'text-inverse',
};
const textClass = textTones[textTone ?? 'default'];

const paddingsTop: Record<string, string> = {
	none: 'pt-0',
	normal: 'pt-[var(--space-block)]',
	large: 'pt-[calc(var(--space-block)*2)]',
	xl: 'pt-[100px]',
};
const paddingsBottom: Record<string, string> = {
	none: 'pb-0',
	normal: 'pb-[var(--space-block)]',
	large: 'pb-[calc(var(--space-block)*2)]',
	xl: 'pb-[100px]',
};

// Odstíny odpovídají tomu, co dnešní web reálně používá: jemné ztmavení
// (černá 25 %) pod hero fotkou a tmavě modrá 70 % pod sekcí s formulářem.
const overlays = {
	dim: 'bg-black/25',
	navy: 'bg-surface-dark/70',
};

const isImage = background === 'image' && !!backgroundImage;
const showParallax = !!parallax && isImage;
const paint = backgrounds[background ?? 'none'];

// U parallaxu kreslí obrázek samostatná vrstva, aby ji šlo zvětšovat bez
// vlivu na obsah; jinak sedí pozadí přímo na sekci.
const backgroundStyle = isImage && !showParallax ? `background-image:url('${backgroundImage}')` : undefined;
const tone = overlays[overlayTone ?? 'dim'];

const spacing = [
	paddingsTop[paddingTop ?? padding ?? 'normal'],
	paddingsBottom[paddingBottom ?? padding ?? 'normal'],
];
---
{
	panel ? (
		<section
			id={id ?? undefined}
			class={cn(
				'relative',
				overlap
					? 'z-10 -my-[var(--space-overlap)] py-[15px]'
					: ['bg-surface', spacing],
				className,
			)}
		>
			<Container>
				<div
					class={cn(
						'relative overflow-hidden rounded-card px-6 py-10 md:px-[45px] md:py-[50px]',
						paint,
						textClass,
					)}
					style={backgroundStyle}
				>
					{isImage && overlay && <div aria-hidden="true" class={`absolute inset-0 ${tone}`}></div>}
					<div class="relative"><slot /></div>
				</div>
			</Container>
		</section>
	) : (
		<section
			id={id ?? undefined}
			class={cn('relative overflow-hidden', paint, textClass, spacing, overlap && '-my-[var(--space-overlap)] z-10', className)}
			style={backgroundStyle}
		>
			{showParallax && (
				<div
					aria-hidden="true"
					class="section-parallax absolute inset-0 bg-cover bg-center"
					style={`background-image:url('${backgroundImage}')`}
				></div>
			)}
			{isImage && overlay && <div aria-hidden="true" class={`absolute inset-0 ${tone}`}></div>}
			<div class="relative">
				{width === 'full' ? <slot /> : <Container><slot /></Container>}
			</div>
		</section>
	)
}

<style>
	/*
	 * Parallax na pozadí sekce. Dnešní web tu má Elementor „motion effect“,
	 * který obrázek při průchodu sekce plynule zvětšuje.
	 *
	 * Tady to dělá `background-attachment: fixed` — pozadí stojí, zatímco
	 * obsah jede přes něj. Není to na chlup stejný efekt jako na produkci,
	 * ale funguje ve všech prohlížečích a nepotřebuje skript.
	 *
	 * Na dotykových zařízeních se vypíná: `fixed` tam bývá rozbité nebo
	 * skokové, takže je lepší statické pozadí.
	 */
	@media (prefers-reduced-motion: no-preference) and (min-width: 768px) and (hover: hover) {
		.section-parallax {
			background-attachment: fixed;
		}
	}
</style>
