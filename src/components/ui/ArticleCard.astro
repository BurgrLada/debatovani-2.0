---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { langFromPath, localizeHref, t } from '../../lib/i18n';
import type { ArticleListItem } from '../../lib/data';

interface Props {
	article: ArticleListItem;
}

const { article } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const strings = t(lang);
const href = localizeHref(`/aktuality/${article.slug}/`, lang);
---
<article class="lift flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface">
	{article.cover && (
		<a href={href} class="block">
			<Image
				src={article.cover}
				alt={article.coverAlt ?? ''}
				width={600}
				height={400}
				format="webp"
				quality={78}
				class="aspect-[3/2] w-full object-cover"
			/>
		</a>
	)}
	<div class="flex flex-1 flex-col p-6">
		<FormattedDate date={article.date} class="text-caption text-muted" />
		<h3 class="mt-2 font-display text-xl font-bold leading-snug">
			<a href={href} class="text-heading">{article.title}</a>
		</h3>
		{article.perex && <p class="mt-3 text-copy">{article.perex}</p>}
		<a href={href} class="mt-auto pt-5 font-semibold underline underline-offset-2">{strings.readMore}</a>
	</div>
</article>
