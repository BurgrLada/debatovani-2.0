# Adresa webu pro kanonické odkazy, sitemapu a RSS.
SITE_URL=https://debatovani.cz

# ── Režim TinaCMS ─────────────────────────────────────────────────────────────
# true  = lokální vývoj: obsah se čte a zapisuje přímo v pracovní kopii,
#         index běží v paměti, nepřihlašuje se (`pnpm dev` to nastavuje samo).
# false = self-hosted backend: obsah přes GitHub API, index v souboru,
#         přihlášení účtem Google Workspace.
TINA_PUBLIC_IS_LOCAL=false

# ── Data mimo git ─────────────────────────────────────────────────────────────
# Adresář se dvěma SQLite soubory. Vzniká, když neexistuje. Databázový server
# projekt nemá — k provozu stačí tenhle Node proces (docs/16).
#
#   index-<větev>.sqlite   index obsahu pro TinaCMS. Obsah samotný v něm není
#                          — ten zůstává v gitu, takže ztráta indexu znamená
#                          přeindexování, ne ztrátu dat.
#   auth.sqlite            účty a relace. Tenhle odvozený není: když se ztratí,
#                          redakce se odhlásí.
#
# V produkci musí adresář ležet na **persistentním volume**. Na ephemerálním
# kontejneru by přihlášení nepřežilo restart.
DATA_DIR=/var/lib/debatovani

# ── Přihlášení do administrace ────────────────────────────────────────────────
# Náhodný tajný klíč pro podpis relací: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Veřejná adresa webu (kvůli návratové adrese od Googlu).
BETTER_AUTH_URL=https://debatovani.cz

# OAuth klient z Google Cloud Console. Consent screen nastavte jako **Internal**
# — pak se přihlásí jen účet z organizace a aplikaci nemusí Google verifikovat.
# Návratová adresa: https://debatovani.cz/api/auth/callback/google
# (pro vývoj i http://localhost:4321/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kdo smí do administrace. Doména se ověřuje proti claimu `hd` z Googlu,
# seznam adres je nad ní: mít pracovní e-mail neznamená spravovat web.
# Prázdný seznam nepouští nikoho. Změna vyžaduje restart Node procesu.
AUTH_ALLOWED_DOMAIN=debatovani.cz
AUTH_ALLOWED_EMAILS=

# ── Zápis obsahu do gitu ──────────────────────────────────────────────────────
# Node proces nemá checkout repozitáře, takže commituje přes GitHub API pod
# servisním účtem. Token potřebuje právo zápisu do obsahu repozitáře.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_PERSONAL_ACCESS_TOKEN=
